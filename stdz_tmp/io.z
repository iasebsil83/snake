// ---------------- DEFINITIONS ----------------

//basics
mod IO {
	typ file {
		s4 fd = -1
		//eventually other stuff to include...
	}
	cst STDIN  = file { 0 }
	cst STDOUT = file { 1 }
	cst STDERR = file { 2 }






	// ---------------- TOOLS ----------------

	//basics
	voi ^.file.fsync() { ^LLI.^Syscall.fsync(sbj.fd) }



	//read / write
	str ^.file.read(s8 length) {
		result = str { length, new(length) }
		^LLI.^Syscall.read(sbj.fd, result.data, length)
		ret result
	}

	voi ^.file.write(str msg) {
		^LLI.^Syscall.write(sbj.fd, msg.data, msg.length)
	}



	//print / scan
	str scan(s8 length) { ret ^.STDIN.read(length) }

	voi print(str msg) { ^.STDOUT.write(msg) }
}
