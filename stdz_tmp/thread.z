// ---------------- DEFINITIONS ----------------

//threads
typ thread { ptr function, ptr args, ulng tid }






// ---------------- TOOLS ----------------

//basics
mod Thread {
	thread new(ptr function, ptr args) {
		thread t = new(#thread)

		//set struct values
		t.function = function
		t.tid      = 0        //t.tid will be set when launching the thread
		t.args     = args
		ret t
	}
}

voi thread.start() {
	pthread_create(&t.tid, null, t.function, t.args)
}
